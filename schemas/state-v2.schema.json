{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-process-studio.local/schemas/state-v2.schema.json",
  "title": "AI Process Studio state v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "organizations", "projects", "processes", "analyses",
    "opportunities", "targetProcesses", "sops", "roadmapItems", "documents",
    "prompts", "events", "settings"
  ],
  "properties": {
    "schemaVersion": { "const": "2.1.0" },
    "organizations": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/entity" } },
    "projects": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/entity" } },
    "processes": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/process" } },
    "analyses": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/entity" } },
    "opportunities": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/opportunity" } },
    "targetProcesses": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/targetProcess" } },
    "sops": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/entity" } },
    "roadmapItems": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/entity" } },
    "documents": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/entity" } },
    "prompts": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/entity" } },
    "events": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/entity" } },
    "settings": {
      "type": "object",
      "required": ["companyName", "locale", "aiMode", "scoringWeights"],
      "properties": {
        "companyName": { "type": "string", "maxLength": 200 },
        "locale": { "const": "fr" },
        "aiMode": { "const": "manual" },
        "scoringWeights": { "$ref": "#/$defs/scores" }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 200 },
    "entity": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/identifier" } }
    },
    "step": {
      "type": "object",
      "required": ["id", "order", "name", "durationMinutes", "waitMinutes"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "order": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "durationMinutes": { "type": "number", "minimum": 0 },
        "waitMinutes": { "type": "number", "minimum": 0 }
      }
    },
    "process": {
      "type": "object",
      "required": ["id", "projectId", "name", "status", "version", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "projectId": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "status": { "enum": ["Brouillon", "À valider", "Validé"] },
        "version": { "type": "integer", "minimum": 1 },
        "steps": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "scores": {
      "type": "object",
      "required": ["timeGain", "frequency", "businessImpact", "ease", "risk", "confidentiality"],
      "properties": {
        "timeGain": { "type": "number", "minimum": -5, "maximum": 5 },
        "frequency": { "type": "number", "minimum": -5, "maximum": 5 },
        "businessImpact": { "type": "number", "minimum": -5, "maximum": 5 },
        "ease": { "type": "number", "minimum": -5, "maximum": 5 },
        "risk": { "type": "number", "minimum": -5, "maximum": 5 },
        "confidentiality": { "type": "number", "minimum": -5, "maximum": 5 }
      }
    },
    "opportunity": {
      "allOf": [
        { "$ref": "#/$defs/entity" },
        {
          "type": "object",
          "required": ["processId", "title", "category", "scores", "weightedScore", "classification", "status"],
          "properties": {
            "processId": { "$ref": "#/$defs/identifier" },
            "title": { "type": "string", "minLength": 1 },
            "category": { "enum": ["Simplifier", "Automatiser", "Assister par IA", "Automatiser par IA", "Ne rien faire"] },
            "scores": { "$ref": "#/$defs/scores" },
            "weightedScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "classification": { "enum": ["Quick Win", "Prioritaire", "Structurant", "À différer", "À éviter"] },
            "status": { "enum": ["Brouillon", "À valider", "Validé", "Rejeté"] }
          }
        }
      ]
    },
    "targetProcess": {
      "allOf": [
        { "$ref": "#/$defs/entity" },
        {
          "type": "object",
          "required": ["sourceProcessId", "name", "steps", "status"],
          "properties": {
            "sourceProcessId": { "$ref": "#/$defs/identifier" },
            "name": { "type": "string", "minLength": 1 },
            "steps": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/step" } },
            "status": { "enum": ["Brouillon", "À valider", "Validé", "Rejeté"] }
          }
        }
      ]
    }
  }
}
